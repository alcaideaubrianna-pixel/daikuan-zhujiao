# 对外 API 地址，用于本地文件上传返回可访问 URL
APP_BASE_URL=https://api.example.com

# 数据库（二选一：DATABASE_URL，或 DB_HOST/DB_PORT/DB_USERNAME/DB_PASSWORD/DB_DATABASE）
DATABASE_URL=
# 首次发布新增实体时临时设为 true，成功建表后立即改回 false
DB_SYNCHRONIZE=false
# 托管 PostgreSQL 通常需要 SSL；明确不需要时设为 false
DB_SSL=true

# 配齐以下变量后，上传自动切换为腾讯云 COS
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=example-1250000000
COS_REGION=ap-guangzhou
# 可选：自定义 COS/CDN 域名
COS_DOMAIN=
